# Für den lokalen Standardstart bleibt diese URL auf 127.0.0.1.
# Für einen öffentlichen Betrieb die kanonische HTTPS-Adresse eintragen.
NEXUS_SITE_URL=http://127.0.0.1:3000
# NEXUS_DATA_DIR=.nexus-data

# Die Website prüft Zugangscodes und Sitzungen ausschließlich beim LingoFlow-Worker.
# Nur für einen lokalen Test-Worker oder eine andere Bereitstellung desselben Workers setzen.
# NEXUS_ACCESS_WORKER_URL=https://lingoflow-worker.stevansabahhakari.workers.dev
# Ausschließlich für einen isolierten Vorschau- oder Inhaltstest auf der lokalen HTTP-Adresse.
# NEXUS_ACCESS_LOCAL_BYPASS=true

# Administrationszugang (vollständig ausfüllen, um ihn zu aktivieren)
NEXUS_ADMIN_EMAIL=
NEXUS_ADMIN_PASSWORD_HASH=
NEXUS_SESSION_SECRET=

# SMTP-Kontakt (Port 587 mit STARTTLS oder Port 465 mit NEXUS_SMTP_SECURE=true)
NEXUS_SMTP_HOST=
NEXUS_SMTP_PORT=587
NEXUS_SMTP_SECURE=false
NEXUS_SMTP_USER=
NEXUS_SMTP_PASSWORD=
NEXUS_CONTACT_FROM=
NEXUS_CONTACT_TO=

# Nur wenn ein vertrauenswürdiger Reverse-Proxy den Header selbst setzt.
# NEXUS_CLIENT_IP_HEADER=x-real-ip
